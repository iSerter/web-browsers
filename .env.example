# =============================================================================
# web-browsers — environment configuration
# Copy to .env for local dev, or set these in your platform (Coolify) for prod.
# =============================================================================

# --- API ---
API_PORT=3030
# Number of concurrent browser workers (also the number of queues)
BROWSER_COUNT=5

# --- Auth ---
# Comma-separated list of valid access keys. Required in production.
# Example: ACCESS_KEYS=key-one,key-two
ACCESS_KEYS=changeme-key-1,changeme-key-2

# --- Redis ---
# External by default. Point at your shared/remote Redis here.
#   Bundled optional container:  redis://redis:6379
#   Remote with auth + db index: redis://:password@your-redis-host:6379/0
#   TLS:                         rediss://:password@your-redis-host:6379/0
REDIS_URL=redis://localhost:6379

# --- Proxies (pattern: PROXY_<COUNTRY_CODE>) ---
# PROXY_DEFAULT is used when no country-specific proxy matches.
PROXY_DEFAULT="http://username:password@example.org:80"
PROXY_US="http://username:password@example.org:80"
PROXY_UK="http://username:password@example.org:80"
PROXY_CA="http://username:password@example.org:80"
PROXY_AU="http://username:password@example.org:80"
PROXY_DE="http://username:password@example.org:80"
PROXY_FR="http://username:password@example.org:80"
PROXY_IT="http://username:password@example.org:80"
PROXY_ES="http://username:password@example.org:80"
PROXY_PL="http://username:password@example.org:80"
PROXY_NL="http://username:password@example.org:80"

# --- Logging ---
PUPPETEER_LAUNCH_LOG=/tmp/puppeteer-session.log
LOG_CLEAN_INTERVAL_MS=3600000
# delete | truncate
LOG_CLEAN_STRATEGY=delete
